# Página 404 personalizada
ErrorDocument 404 /404.php

# No listar directorios
Options -Indexes

# Defensa en profundidad: nunca servir config.php como texto plano
<Files "config.php">
  Require all denied
</Files>

# Cabeceras de seguridad
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; media-src 'self' https://radio.chateanos.com; connect-src 'self' https://radio.chateanos.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"
</IfModule>
